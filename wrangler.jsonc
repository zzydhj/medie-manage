{
  // 线上资源(2026-09-21 创建于账号 c58d6530…ff6):
  //   D1: medie-manage-db → 28d72062-d386-4812-8258-baa842370c5c
  //   R2: medie-manage-assets
  //   SESSION_SECRET: 通过 `wrangler pages secret put SESSION_SECRET` 配置,不入库
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medie-manage",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "medie-manage-db",
      "database_id": "28d72062-d386-4812-8258-baa842370c5c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "medie-manage-assets"
    }
  ]
}
