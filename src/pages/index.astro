---
import Base from '../layouts/Base.astro';

// 服务端已知登录态(中间件注入),用于首屏直接决定是否需要跳转
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login');
}
---

<Base title="资料素材库">
  <!-- ===== 顶栏 ===== -->
  <header class="app-header">
    <button id="menu-toggle" class="header-btn menu-toggle" title="菜单">
      <i class="fa-solid fa-bars"></i>
    </button>
    <span class="brand"><i class="fa-solid fa-book-open mr-1"></i> 资料素材库</span>

    <!-- 公司切换器:仅超级管理员可见(客户端根据 /api/me 填充);右侧带到期 chip -->
    <span id="org-switch-wrap" class="org-switch-wrap hidden">
      <select id="org-switcher" class="org-select" title="切换公司"></select>
      <!-- 会员到期 chip:点击弹日期选择器设置/清除当前公司到期日;到期公司账号登录被拒 -->
      <button id="org-expiry-chip" class="expiry-chip" type="button" title="点击设置会员到期日期"></button>
      <input id="org-expiry-input" type="date" class="expiry-input-offscreen" />
    </span>
    <!-- 非超管:静态公司名(与超管切换器同款白胶囊,只读不可切) -->
    <span id="org-name-badge" class="org-select org-name-static hidden"></span>
    <!-- VIP 角标:金渐变+皇冠+呼吸光,置左侧身份区,传达付费开通感 -->
    <span class="vip-badge" title="VIP 已开通"><i class="fa-solid fa-crown"></i>VIP</span>

    <div class="spacer"></div>

    <!-- 类型快捷筛选:分段 chips(选项常可见+激活态明确,比下拉直观);窄屏随搜索框搬进抽屉 -->
    <div class="type-filter" id="type-filter">
      <button class="tf-chip active" data-tf="" type="button" title="显示全部类型">
        <i class="fa-solid fa-layer-group"></i><span>全部</span>
      </button>
      <button class="tf-chip" data-tf="image" type="button" title="只显示图片">
        <i class="fa-regular fa-image"></i><span>图片</span>
      </button>
      <button class="tf-chip" data-tf="video" type="button" title="只显示视频">
        <i class="fa-solid fa-film"></i><span>视频</span>
      </button>
      <button class="tf-chip" data-tf="doc" type="button" title="只显示文档(PDF/Word/Excel)">
        <i class="fa-regular fa-file-lines"></i><span>文档</span>
      </button>
    </div>

    <!-- 搜索:按文件名或标题过滤当前公司素材(全公司范围) -->
    <div class="search-control" id="search-control">
      <i class="fa-solid fa-magnifying-glass search-icon"></i>
      <!-- type=search:浏览器不会把保存的登录凭据自动填进搜索类输入框;name=q 进一步明确语义 -->
      <input id="search-input" type="search" name="q" placeholder="搜索文件名 / 标题" autocomplete="off" />
      <button id="search-clear" class="search-clear hidden" title="清空搜索" type="button">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- 批量选择:开启后卡片可勾选,支持逐个下载 / 手机端多文件分享 -->
    <button id="btn-batch" class="header-btn" title="批量选择">
      <i class="fa-solid fa-list-check"></i><span class="hidden sm:inline">批量</span>
    </button>

    <!-- 每行列数(卡片密度)调节:自定义下拉,选择记忆到本地 -->
    <div class="cols-control" id="cols-control">
      <button class="cols-trigger" id="col-trigger" title="每行显示列数" aria-haspopup="listbox" aria-expanded="false">
        <i class="fa-solid fa-table-columns"></i>
        <span id="col-label">10 列</span>
        <i class="fa-solid fa-chevron-down cols-caret"></i>
      </button>
      <div class="cols-menu" id="col-menu" role="listbox" aria-label="每行列数">
        <button class="cols-option" data-cols="4" role="option">4 列</button>
        <button class="cols-option" data-cols="6" role="option">6 列</button>
        <button class="cols-option" data-cols="8" role="option">8 列</button>
        <button class="cols-option" data-cols="10" role="option">10 列</button>
        <button class="cols-option" data-cols="12" role="option">12 列</button>
        <button class="cols-option" data-cols="16" role="option">16 列</button>
      </div>
    </div>

    <span id="whoami" class="text-xs font-semibold opacity-90 hidden sm:inline"></span>
    <button id="btn-companies" class="header-btn hidden" title="公司管理">
      <i class="fa-solid fa-building"></i><span class="hidden sm:inline">公司</span>
    </button>
    <button id="btn-users" class="header-btn hidden" title="用户管理">
      <i class="fa-solid fa-users"></i><span class="hidden sm:inline">用户</span>
    </button>
    <!-- 补缩略图:给功能上线前传的老图片/老 PDF 一次性补生成缩略图(PDF 为首页预览图)(管理员可见) -->
    <button id="btn-backfill" class="header-btn hidden" title="为无缩略图的老图片/PDF 补生成缩略图(预览图)">
      <i class="fa-solid fa-images"></i><span class="hidden sm:inline">补缩略图</span>
    </button>
    <button id="btn-storage" class="header-btn hidden" title="存储用量">
      <i class="fa-solid fa-hard-drive"></i><span class="hidden sm:inline">用量</span>
    </button>
    <button id="btn-logout" class="header-btn" title="退出登录">
      <i class="fa-solid fa-right-from-bracket"></i><span class="hidden sm:inline">退出</span>
    </button>
  </header>

  <!-- ===== 侧边栏 ===== -->
  <div id="sidebar-overlay" class="sidebar-overlay"></div>
  <aside id="sidebar" class="sidebar">
    <div class="sidebar-scroll">
      <div id="menu-tree"></div>
      <button id="add-root-menu" class="add-root-btn hidden">
        <i class="fa-solid fa-plus mr-1"></i> 新增一级菜单
      </button>
    </div>
  </aside>

  <!-- ===== 主体卡片区 ===== -->
  <main class="main-content">
    <div id="card-grid" class="card-grid"></div>
  </main>

  <!-- ===== 手机端:搜索抽屉(窄屏时 #search-control 由 JS 搬进来,保持单一输入源) ===== -->
  <div id="mobile-search" class="mobile-search"></div>

  <!-- ===== 手机端:底部导航(搜索 / 菜单 / 批量 / 账户) ===== -->
  <nav id="mobile-nav" class="mobile-nav">
    <button class="mnav-btn" id="mnav-search" type="button">
      <i class="fa-solid fa-magnifying-glass"></i><span>搜索</span>
    </button>
    <button class="mnav-btn" id="mnav-menu" type="button">
      <i class="fa-solid fa-bars"></i><span>菜单</span>
    </button>
    <button class="mnav-btn" id="mnav-batch" type="button">
      <i class="fa-solid fa-list-check"></i><span>批量</span>
    </button>
    <button class="mnav-btn" id="mnav-account" type="button">
      <i class="fa-regular fa-user"></i><span>账户</span>
    </button>
  </nav>

  <!-- ===== 批量选择操作条:进入批量模式后出现(手机端悬在底部导航上方) ===== -->
  <div id="batch-bar" class="batch-bar hidden">
    <span class="batch-count">已选 <b id="batch-count">0</b> 项</span>
    <button class="batch-btn ghost" id="batch-all" type="button" title="全选 / 取消全选">
      <i class="fa-solid fa-list-check"></i><span>全选</span>
    </button>
    <button class="batch-btn" id="batch-download" type="button" title="逐个下载所选文件">
      <i class="fa-solid fa-download"></i><span>下载</span>
    </button>
    <button class="batch-btn" id="batch-share" type="button" title="调起系统分享,可一次发多个文件">
      <i class="fa-solid fa-share-nodes"></i><span>分享</span>
    </button>
    <button class="batch-btn ghost" id="batch-zip" type="button" title="打包成一个 ZIP 下载(浏览器拦截多文件下载时用)">
      <i class="fa-solid fa-file-zipper"></i><span>打包</span>
    </button>
    <!-- 管理类操作:仅管理员可见(JS 按 isAdmin 去掉 hidden);普通用户批量条只有下载/分享 -->
    <button class="batch-btn ghost hidden" id="batch-move" type="button" title="移动到其它分组">
      <i class="fa-solid fa-folder-open"></i><span>移动</span>
    </button>
    <button class="batch-btn ghost danger hidden" id="batch-delete" type="button" title="删除所选素材">
      <i class="fa-solid fa-trash"></i><span>删除</span>
    </button>
    <button class="batch-btn ghost" id="batch-exit" type="button" title="退出批量">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>

  <!-- ===== 手机端:账户 sheet(身份 + 公司切换 + 管理入口 + 退出) ===== -->
  <div id="account-mask" class="account-mask"></div>
  <div id="account-sheet" class="account-sheet">
    <div class="account-head">
      <div class="account-avatar"><i class="fa-solid fa-user"></i></div>
      <div class="account-id">
        <div id="account-name" class="account-name">—</div>
        <div id="account-role" class="account-role"></div>
      </div>
      <!-- 手机端顶栏隐藏,VIP 角标在账户 sheet 头部补一个落点 -->
      <span class="vip-badge vip-badge-sm" title="VIP 已开通"><i class="fa-solid fa-crown"></i>VIP</span>
      <button class="mini-btn" id="account-close" type="button" title="关闭">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    <div class="account-body">
      <div id="account-org-field" class="account-field hidden">
        <label>当前公司</label>
        <!-- 窄屏时 #org-switcher 由 JS 搬进来 -->
      </div>
      <button class="account-item hidden" id="account-companies" type="button">
        <i class="fa-solid fa-building"></i><span>公司管理</span><i class="fa-solid fa-chevron-right arrow"></i>
      </button>
      <button class="account-item hidden" id="account-users" type="button">
        <i class="fa-solid fa-users"></i><span>用户管理</span><i class="fa-solid fa-chevron-right arrow"></i>
      </button>
      <button class="account-item hidden" id="account-backfill" type="button">
        <i class="fa-solid fa-images"></i><span>补生成缩略图</span><i class="fa-solid fa-chevron-right arrow"></i>
      </button>
      <button class="account-item hidden" id="account-storage" type="button">
        <i class="fa-solid fa-hard-drive"></i><span>存储用量</span><i class="fa-solid fa-chevron-right arrow"></i>
      </button>
      <button class="account-item danger" id="account-logout" type="button">
        <i class="fa-solid fa-right-from-bracket"></i><span>退出登录</span>
      </button>
    </div>
  </div>

  <!-- ===== 菜单 新增/编辑 弹窗 ===== -->
  <div id="menu-modal" class="modal-mask">
    <div class="modal-box">
      <div class="modal-head">
        <span id="menu-modal-title">新增菜单</span>
        <button class="mini-btn" data-close="menu-modal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label>父级菜单</label>
          <input id="menu-parent-label" type="text" disabled />
        </div>
        <div class="field">
          <label>菜单名称</label>
          <input id="menu-name" type="text" placeholder="输入菜单名称" />
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close="menu-modal">取消</button>
        <button id="menu-save" class="btn btn-primary">保存</button>
      </div>
    </div>
  </div>

  <!-- ===== 菜单 移动到 弹窗(管理员:跨分组/改父级,补拖拽做不到的场景) ===== -->
  <div id="menu-move-modal" class="modal-mask">
    <div class="modal-box">
      <div class="modal-head">
        <span>移动菜单</span>
        <button class="mini-btn" data-close="menu-move-modal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label id="menu-move-tip">移动到</label>
          <select id="menu-move-parent"></select>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close="menu-move-modal">取消</button>
        <button id="menu-move-confirm" class="btn btn-primary">移动</button>
      </div>
    </div>
  </div>

  <!-- ===== 素材 新增 弹窗 ===== -->
  <div id="item-modal" class="modal-mask">
    <div class="modal-box">
      <div class="modal-head">
        <span>新增素材</span>
        <button class="mini-btn" data-close="item-modal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label>所属菜单</label>
          <input id="item-menu-label" type="text" disabled />
        </div>
        <div class="field">
          <label>选择文件(图片 / 视频 / PDF / Word / Excel,可多选)</label>
          <div id="dropzone" class="dropzone">
            <i class="fa-solid fa-cloud-arrow-up text-2xl mb-2 block"></i>
            点击或拖拽文件到此处上传(可多选,重复自动跳过)
          </div>
          <input id="file-input" type="file" accept="image/*,video/*,.pdf,.doc,.docx,.xls,.xlsx" multiple class="hidden" />
        </div>
        <div id="file-preview" class="preview-wrap hidden"></div>
        <!-- 批量上传:选多个文件时展开,逐个上传并标注 新增 / 跳过重复 / 失败 -->
        <div id="batch-panel" class="batch-panel hidden">
          <div id="batch-list" class="batch-list"></div>
        </div>
        <div class="field">
          <label>标题</label>
          <input id="item-title" type="text" name="item-title" placeholder="素材标题(默认取文件名)" autocomplete="off" />
        </div>
        <div id="upload-status" class="text-xs font-semibold text-slate-500"></div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close="item-modal">取消</button>
        <button id="item-save" class="btn btn-primary" disabled>保存</button>
      </div>
    </div>
  </div>

  <!-- ===== 素材 编辑 弹窗(改标题 / 换分组) ===== -->
  <div id="item-edit-modal" class="modal-mask">
    <div class="modal-box">
      <div class="modal-head">
        <span>编辑素材</span>
        <button class="mini-btn" data-close="item-edit-modal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label>标题</label>
          <input id="item-edit-title" type="text" name="item-edit-title" placeholder="素材标题" autocomplete="off" />
        </div>
        <div class="field">
          <label>所属分组</label>
          <select id="item-edit-menu"></select>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close="item-edit-modal">取消</button>
        <button id="item-edit-save" class="btn btn-primary">保存</button>
      </div>
    </div>
  </div>

  <!-- ===== 批量移动分组 弹窗(管理员) ===== -->
  <div id="batch-move-modal" class="modal-mask">
    <div class="modal-box">
      <div class="modal-head">
        <span>移动到分组</span>
        <button class="mini-btn" data-close="batch-move-modal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label id="batch-move-tip">目标分组</label>
          <select id="batch-move-menu"></select>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost" data-close="batch-move-modal">取消</button>
        <button id="batch-move-confirm" class="btn btn-primary">移动</button>
      </div>
    </div>
  </div>

  <!-- ===== 会员到期锁屏:全屏遮罩盖住整站(仅留退出登录);右键/拖拽/保存快捷键全禁并弹续费弹窗 ===== -->
  <div id="lock-screen" class="lock-screen hidden">
    <i class="fa-solid fa-crown lock-icon"></i>
    <div class="lock-title">会员到期</div>
    <div class="lock-text">续费后使用</div>
    <div class="lock-sub">素材浏览与所有功能已停用,请联系管理员续费</div>
    <button id="lock-logout" class="btn btn-ghost lock-logout" type="button">退出登录</button>
  </div>

  <!-- ===== 会员到期续费提示大弹窗(到期公司账号点任何功能时弹) ===== -->
  <div id="expiry-modal" class="modal-mask">
    <div class="modal-box expiry-modal-box">
      <i class="fa-solid fa-crown expiry-modal-icon"></i>
      <div class="expiry-modal-title">会员到期</div>
      <div class="expiry-modal-text">续费后使用</div>
      <button class="btn btn-primary expiry-modal-btn" data-close="expiry-modal">我知道了</button>
    </div>
  </div>

  <!-- ===== 新设备首登预热:全屏进度窗,后台把列表+缩略图灌进缓存,刷完秒开;可跳过转后台静默 ===== -->
  <div id="warmup-overlay" class="warmup-overlay hidden">
    <div class="warmup-box">
      <i class="fa-solid fa-bolt warmup-icon"></i>
      <div class="warmup-title">首次新设备登录,努力加载中</div>
      <div class="warmup-track"><div id="warmup-bar" class="warmup-bar"></div></div>
      <div class="warmup-meta">
        <span id="warmup-label">正在准备…</span>
        <span id="warmup-pct">0%</span>
      </div>
      <button id="warmup-skip" class="btn btn-ghost warmup-skip" type="button">跳过,先浏览(后台继续加载)</button>
    </div>
  </div>

  <!-- ===== 公司管理 弹窗(超级管理员) ===== -->
  <div id="org-modal" class="modal-mask">
    <div class="modal-box">
      <div class="modal-head">
        <span>公司管理</span>
        <button class="mini-btn" data-close="org-modal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label>新增公司</label>
          <div class="flex gap-2">
            <input id="new-org-name" type="text" placeholder="公司名称" class="flex-1" />
            <button id="add-org" class="btn btn-primary">添加</button>
          </div>
        </div>
        <div id="org-list" class="flex flex-col"></div>
      </div>
    </div>
  </div>

  <!-- ===== 存储用量 弹窗(管理员:超管看全部公司,公司管理员看本公司) ===== -->
  <div id="storage-modal" class="modal-mask">
    <div class="modal-box">
      <div class="modal-head">
        <span>存储用量</span>
        <button class="mini-btn" data-close="storage-modal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div id="storage-total" class="storage-total"></div>
        <div id="storage-list" class="flex flex-col"></div>
        <p class="storage-note">按各公司素材原文件大小合计(不含缩略图),实时统计。</p>
      </div>
    </div>
  </div>

  <!-- ===== 用户管理 弹窗 ===== -->
  <div id="user-modal" class="modal-mask">
    <div class="modal-box">
      <div class="modal-head">
        <span>用户管理</span>
        <button class="mini-btn" data-close="user-modal"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="modal-body">
        <div class="field" id="user-org-field">
          <label>所属公司</label>
          <select id="user-org-select"></select>
        </div>
        <div class="field">
          <label>新增用户</label>
          <input id="new-user-name" type="text" name="new-username" placeholder="用户名" autocomplete="off" />
          <input id="new-user-pass" type="password" name="new-password" placeholder="密码(至少 6 位)" autocomplete="new-password" />
          <select id="new-user-role">
            <option value="user">普通用户(仅下载)</option>
            <option value="admin">公司管理员(可编辑本公司)</option>
          </select>
          <button id="add-user" class="btn btn-primary">添加用户</button>
        </div>
        <div id="user-list" class="flex flex-col"></div>
      </div>
    </div>
  </div>

  <!-- 图片/视频放大预览:关灯式全屏,无边缘包裹,支持左右切换 -->
  <div id="lightbox" class="lightbox">
    <button class="lb-close" id="lb-close" title="关闭 (Esc)"><i class="fa-solid fa-xmark"></i></button>
    <button class="lb-nav lb-prev" id="lb-prev" title="上一个 (←)"><i class="fa-solid fa-chevron-left"></i></button>
    <div class="lb-stage" id="lightbox-body"></div>
    <button class="lb-nav lb-next" id="lb-next" title="下一个 (→)"><i class="fa-solid fa-chevron-right"></i></button>
    <div class="lb-caption" id="lightbox-title"></div>
    <!-- 手机端提示:长按图片出系统菜单(存储图像/分享),进相册的可靠路径 -->
    <div id="lb-hint" class="lb-hint hidden">长按图片可保存到相册或分享</div>
  </div>

  <div id="toast" class="toast"></div>

  <script>
    import '../client/app';
  </script>
</Base>
