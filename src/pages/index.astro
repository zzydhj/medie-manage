---
import Marketing from "../layouts/Marketing.astro";
import ShotFallback from "../components/landing/ShotFallback.astro";
import { SITE, SIGNUP_LABEL } from "../lib/site";

// 已登录用户访问首页时,右上角给「进入控制台」而不是登录/注册
const user = Astro.locals.user;

// 开通相关文案随站点配置切换:自助注册关闭时不承诺「提交即开通」
const signup = SIGNUP_LABEL;
const heroCta = SITE.openRegistration ? "立即免费开通" : "申请开通体验";
const heroNote = SITE.openRegistration
    ? "无需信用卡 · 提交即建好属于你公司的独立素材库"
    : SITE.contact
        ? `人工开户 · 致电 ${SITE.contact} 当天开通,含 ${SITE.trialDays} 天全功能试用`
        : `人工开户 · 联系管理员当天开通,含 ${SITE.trialDays} 天全功能试用`;
const signupStep = SITE.openRegistration
    ? {
          title: "注册开通",
          desc: "填写公司名称与管理员账号,提交后系统立刻建好属于你公司的独立素材库,并自动登录进入后台。",
      }
    : {
          title: "申请开通",
          desc: "联系管理员提供公司名称与管理员账号,由我们为你建好独立的素材库并开通试用,当天可用。",
      };

// ============================================================
//  站点内容:改文案 / 改价格只需要动下面这几个数组
// ============================================================

/** 三档订阅价格(占位价,按实际商务策略调整即可) */
const PLANS = [
    {
        name: "体验版",
        price: "0",
        unit: "/ 14 天",
        desc: "先把全流程跑通,再决定要不要付费",
        bill: "到期后可升级保留全部数据",
        features: [
            "1 家公司独立素材库",
            "3 个成员账号",
            "2 GB 存储空间",
            "全部功能不限用",
            "图片自动压缩与缩略图",
        ],
        cta: signup,
        href: "/register",
        featured: false,
    },
    {
        name: "标准版",
        price: "199",
        unit: "/ 月",
        was: "¥299",
        desc: "给一个真正在管素材的团队",
        bill: "年付 ¥1,999(相当于 10 个月)",
        features: [
            "20 个成员账号",
            "200 GB 存储空间",
            "无限菜单层级与素材数量",
            "批量下载 / 浏览器内 ZIP 打包",
            "手机端系统级多文件分享",
            "工单优先响应(1 个工作日内)",
        ],
        cta: "开通标准版",
        href: "/register",
        featured: true,
        tag: "最受欢迎",
    },
    {
        name: "旗舰版",
        price: "599",
        unit: "/ 月",
        desc: "多公司统一托管与深度支持",
        bill: "年付 ¥5,999(相当于 10 个月)",
        features: [
            "标准版全部能力",
            "成员账号数不限",
            "1 TB 存储空间",
            "多公司统一后台托管",
            "协助从网盘/服务器迁移存量素材",
            "7×12 专属对接",
        ],
        cta: "详谈开通",
        href: "/register",
        featured: false,
    },
];

/** 核心能力 */
const FEATURES = [
    {
        icon: "fa-building-shield",
        title: "按公司彻底隔离",
        desc: "每家公司的菜单、素材、成员各自独立。文件以公司前缀存放,跨公司的访问在服务端直接判死,不是靠前端藏起来。",
    },
    {
        icon: "fa-sitemap",
        title: "最多 4 级分类目录",
        desc: "按部门、项目、活动自由建树,拖拽即可排序。左侧定位、右侧看货,素材再多也不会堆成一锅。",
    },
    {
        icon: "fa-file-lines",
        title: "全格式在线预览",
        desc: "图片、视频、PDF、Word、Excel 不下载直接看。苹果 HEIC 上传即转 JPG,相机原图自动做视觉无损压缩。",
    },
    {
        icon: "fa-bolt",
        title: '为"翻得快"做的引擎',
        desc: "缩略图预生成、整视图并行铺页、本地缓存复用;老素材缺图会被后台自动补齐,首屏不该等转圈。",
    },
    {
        icon: "fa-download",
        title: "批量下载与分享",
        desc: "勾选多份素材,逐个下载或在浏览器里打成一个 ZIP;手机端可一次调起系统分享,微信、QQ 直接发出去。",
    },
    {
        icon: "fa-user-gear",
        title: "三级成员权限",
        desc: "超级管理员 / 公司管理员 / 普通成员。管理员负责上传与整理分类,成员只负责取用,职责清清楚楚。",
    },
    {
        icon: "fa-calendar-check",
        title: "会员到期可控",
        desc: "按公司设置到期日,到期后停止一切数据下发(连文件字节都拿不到),续费立即恢复——商用闭环自带。",
    },
    {
        icon: "fa-mobile-screen",
        title: "手机上也好用",
        desc: "响应式布局、底部导航、iPhone 安全区适配。在门店、在仓库、在客户现场,掏手机就能翻到要的那张图。",
    },
];

/** 界面截图(放在 public/landing/ 下,文件名即路径;tiles = 缺图时线框占位的色块数) */
const SHOTS = [
    {
        src: "/landing/shot-grid.png",
        title: "素材网格",
        desc: "多级菜单 + 多列缩略图卡片",
        tiles: 8,
    },
    {
        src: "/landing/shot-lightbox.png",
        title: "大图预览",
        desc: "关灯式全屏,左右连续翻图",
        tiles: 4,
    },
    {
        src: "/landing/shot-upload.png",
        title: "拖拽上传",
        desc: "批量拖入,重复自动跳过",
        tiles: 3,
    },
    {
        src: "/landing/shot-admin.png",
        title: "成员管理",
        desc: "开账号、分权限、看用量",
        tiles: 6,
    },
    {
        src: "/landing/shot-mobile.png",
        title: "手机端",
        desc: "同一套数据,随身取用",
        tiles: 3,
    },
];

/** 上手三步(首步文案随开通方式切换) */
const STEPS = [
    signupStep,
    {
        title: "建分类、传素材",
        desc: "按部门或项目搭好菜单树,把图片视频文档整批拖进来;重复文件自动跳过,大图自动压缩并生成缩略图。",
    },
    {
        title: "拉同事进来随取随用",
        desc: "给同事开成员账号,对方登录后只做一件事:找到要用的那份素材,预览、下载、发出去。",
    },
];

/** 保障 */
const ASSURANCE = [
    {
        icon: "fa-lock",
        title: "数据只属于你",
        desc: '公司之间命名空间完全隔离,平台内不存在"别人能翻到你家素材"的路径。',
    },
    {
        icon: "fa-server",
        title: "文件不落第三方",
        desc: "素材存放在 Cloudflare R2 对象存储,不做任何转售、公开展示或二次分发。",
    },
    {
        icon: "fa-shield-halved",
        title: "传输与凭证加固",
        desc: "全站 HTTPS,会话令牌 HMAC-SHA256 签名并存于 HttpOnly Cookie,脚本读不到。",
    },
    {
        icon: "fa-fingerprint",
        title: "密码不可逆存储",
        desc: "PBKDF2-SHA256 加盐十万轮迭代,数据库里只有盐与哈希,没有明文。",
    },
    {
        icon: "fa-rotate",
        title: "到期不丢数据",
        desc: "到期只是停止读写,分类结构与历史素材完整保留,续费后立刻原样恢复。",
    },
    {
        icon: "fa-headset",
        title: "问题有人接",
        desc: "功能建议与故障反馈直达开发方,标准版及以上享工单优先处理。",
    },
];

/** 常见问题 */
const FAQS = [
    {
        q: "它和网盘有什么区别?",
        a: '网盘是"个人文件仓库",这里是"团队素材货架"。区别在于:面向业务的分类目录、卡片式预览、按公司隔离的租户边界、成员权限分级,以及会员到期控制。你要的不是存,是让同事在三十秒内找到能用的那张图。',
    },
    {
        q: "支持哪些文件格式?",
        a: "图片(JPG / PNG / WebP / GIF / BMP / SVG / HEIC)、视频(MP4 / WebM / OGV / MOV / M4V)、PDF、Word(doc / docx)、Excel(xls / xlsx)。单个文件上限 100MB。苹果 HEIC 在上传时即转成 JPG,保证任何设备打开都不挑浏览器。",
    },
    {
        q: "为什么有的视频能在线播,有的只有声音没有画面?",
        a: '因为平台不做服务端转码,在线播放依赖浏览器自身的解码能力。HEVC / H.265(iPhone 拍摄、屏幕录制常见)在多数 Chrome、Edge、Firefox 上解不出视频轨,就会出现"有声音、画面黑屏"。解决办法是把视频转成 H.264(MP4) 再上传——现在新上传时系统会自动检测并提前提醒你,已入库的老素材仍可正常下载后用本地播放器观看。',
    },
    {
        q: "存储用满了能扩吗?",
        a: "可以。套餐内的存储额度可以按公司规模单独调整,详谈即可,不必为了多出来的几十 GB 直接跳档。",
    },
    {
        q: "试用到期后,已经上传的素材会被删掉吗?",
        a: "不会。到期后系统停止一切数据的读写与下发,但分类结构、素材文件、成员账号都完整保留;续费后立即恢复原样。只有长期不续且双方确认不再使用时,才会协商数据导出与清理。",
    },
    {
        q: "能从现有网盘 / 服务器把素材搬过来吗?",
        a: "能。小批量直接拖拽批量上传即可,重复文件会自动跳过;存量很大或需要保留原目录层级的,旗舰版提供迁移协助。",
    },
    {
        q: "可以私有部署或用我们自己的域名吗?",
        a: "可以。旗舰版支持独立域名绑定与数据迁移协助,具体范围按部署形态另议。",
    },
];

const STATS = [
    { v: "5 类", k: "素材格式" },
    { v: "4 级", k: "分类目录" },
    { v: "3 级", k: "成员权限" },
    { v: "100MB", k: "单文件上限" },
    { v: "14 天", k: "免费试用" },
];
---

<Marketing>
    <!-- ===================== 顶部导航 ===================== -->
    <nav class="mk-nav">
        <div class="mk-wrap mk-nav-inner">
            <a class="mk-logo" href="/">
                <span class="mk-logo-mark"
                    ><i class="fa-solid fa-book-open"></i></span
                >
                资料素材库
            </a>
            <div class="mk-nav-links">
                <a href="#features">功能</a>
                <a href="#gallery">界面</a>
                <a href="#pricing">价格</a>
                <a href="#assure">保障</a>
                <a href="#faq">常见问题</a>
            </div>
            <div class="mk-nav-actions">
                {
                    user ? (
                        <a class="mk-btn mk-btn-primary" href="/app">
                            <i class="fa-solid fa-gauge-high" /> 进入控制台
                        </a>
                    ) : (
                        <>
                            <a
                                class="mk-btn mk-btn-ghost mk-btn-sm"
                                href="/login"
                            >
                                登录
                            </a>
                            <a
                                class="mk-btn mk-btn-primary mk-btn-sm"
                                href="/register"
                            >
                                {signup}
                            </a>
                        </>
                    )
                }
            </div>
        </div>
    </nav>

    <!-- ===================== Hero ===================== -->
    <header class="mk-hero">
        <span class="mk-glow mk-glow-a"></span>
        <span class="mk-glow mk-glow-b"></span>
        <div class="mk-wrap">
            <span class="mk-eyebrow">
                <i class="fa-solid fa-gift"></i> 注册即送 14 天全功能试用
            </span>
            <h1 class="mk-h1">
                把全公司的素材<br />
                放进一个<span class="mk-grad-text">找得到</span>的地方
            </h1>
            <p class="mk-lead">
                资料素材库是为中小团队做的在线素材管理平台:按公司隔离、多级分类、
                图片 / 视频 / PDF / Word / Excel 全格式预览、批量下载与分享。
                不用装任何软件,打开浏览器就能用。
            </p>
            <div class="mk-hero-cta">
                <a class="mk-btn mk-btn-primary mk-btn-lg" href="/register">
                    <i class="fa-solid fa-rocket"></i>
                    {heroCta}
                </a>
                <a class="mk-btn mk-btn-ghost mk-btn-lg" href="#pricing">
                    <i class="fa-solid fa-tags"></i> 查看价格
                </a>
            </div>
            <p class="mk-hero-note">
                {heroNote}
            </p>

            <div class="mk-stats">
                {
                    STATS.map((s) => (
                        <div class="mk-stat">
                            <b class="mk-grad-text">{s.v}</b>
                            <span>{s.k}</span>
                        </div>
                    ))
                }
            </div>

            <div class="mk-shot mk-reveal">
                <div class="mk-shot-bar">
                    <i></i>
                    <i></i>
                    <i></i>
                    <span class="mk-shot-url">media.zzydhj.com/app</span>
                </div>
                <img
                    src="/landing/shot-grid.png"
                    data-shot
                    alt="资料素材库后台:左侧多级分类菜单与右侧素材卡片网格"
                    width="1600"
                    height="1000"
                    loading="eager"
                />
                <ShotFallback note="素材网格界面截图准备中" />
            </div>
        </div>
    </header>

    <!-- ===================== 功能 ===================== -->
    <section class="mk-section" id="features">
        <div class="mk-wrap">
            <div class="mk-section-head mk-reveal">
                <span class="mk-eyebrow"
                    ><i class="fa-solid fa-puzzle-piece"></i> 功能</span
                >
                <h2 class="mk-h2" style="margin-top:16px">
                    八件它真的替你想过的事
                </h2>
                <p class="mk-lead">
                    不是把"文件夹"搬到网页上就完事,而是把素材从进库、整理、查找、预览到取用的整条路都铺平。
                </p>
            </div>
            <div class="mk-grid">
                {
                    FEATURES.map((f) => (
                        <article class="mk-card mk-reveal">
                            <div class="mk-card-icon">
                                <i class:list={["fa-solid", f.icon]} />
                            </div>
                            <h3 class="mk-h3">{f.title}</h3>
                            <p>{f.desc}</p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ===================== 界面截图 ===================== -->
    <section
        class="mk-section"
        id="gallery"
        style="background:var(--mk-bg-soft)"
    >
        <div class="mk-wrap">
            <div class="mk-section-head mk-reveal">
                <span class="mk-eyebrow"
                    ><i class="fa-solid fa-display"></i> 界面</span
                >
                <h2 class="mk-h2" style="margin-top:16px">
                    长这样,没有惊喜也没有坑
                </h2>
                <p class="mk-lead">
                    下面是真实系统的界面截图,不是设计稿。登录后看到的就是这些。
                </p>
            </div>
            <div class="mk-gallery">
                {
                    SHOTS.map((s) => (
                        <figure class="mk-figure mk-reveal">
                            <img
                                src={s.src}
                                data-shot
                                alt={`${s.title}界面截图`}
                                width="1600"
                                height="1000"
                                loading="lazy"
                            />
                            <ShotFallback
                                tiles={s.tiles}
                                note={`${s.title}截图准备中`}
                            />
                            <figcaption>
                                <b>{s.title}</b> · {s.desc}
                            </figcaption>
                        </figure>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ===================== 上手三步 ===================== -->
    <section class="mk-section" id="steps">
        <div class="mk-wrap">
            <div class="mk-section-head mk-reveal">
                <span class="mk-eyebrow"
                    ><i class="fa-solid fa-route"></i> 怎么开始</span
                >
                <h2 class="mk-h2" style="margin-top:16px">
                    三步,今天就能用起来
                </h2>
            </div>
            <div class="mk-steps">
                {
                    STEPS.map((s) => (
                        <article class="mk-step mk-reveal">
                            <h3 class="mk-h3">{s.title}</h3>
                            <p>{s.desc}</p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ===================== 价格 ===================== -->
    <section
        class="mk-section"
        id="pricing"
        style="background:var(--mk-bg-soft)"
    >
        <div class="mk-wrap">
            <div class="mk-section-head mk-reveal">
                <span class="mk-eyebrow"
                    ><i class="fa-solid fa-tags"></i> 订阅价格</span
                >
                <h2 class="mk-h2" style="margin-top:16px">
                    按公司算,不按人头卡你
                </h2>
                <p class="mk-lead">
                    所有档位功能完整,差别只在成员数与存储额度。先试用,觉得值再付钱。
                </p>
            </div>

            <div class="mk-plans">
                {
                    PLANS.map((p) => (
                        <article
                            class:list={[
                                "mk-plan",
                                "mk-reveal",
                                { "mk-plan-featured": p.featured },
                            ]}
                        >
                            {p.tag && <span class="mk-plan-tag">{p.tag}</span>}
                            <div class="mk-plan-name">{p.name}</div>
                            <p class="mk-plan-desc">{p.desc}</p>
                            <div class="mk-price">
                                <span>¥</span>
                                <b>{p.price}</b>
                                <span>{p.unit}</span>
                                {p.was && <s>{p.was}</s>}
                            </div>
                            <div class="mk-plan-bill">{p.bill}</div>
                            <ul>
                                {p.features.map((f) => (
                                    <li>
                                        <i class="fa-solid fa-check" />
                                        <span>{f}</span>
                                    </li>
                                ))}
                            </ul>
                            <a
                                class:list={[
                                    "mk-btn",
                                    p.featured
                                        ? "mk-btn-primary"
                                        : "mk-btn-ghost",
                                ]}
                                href={p.href}
                            >
                                {p.cta}
                            </a>
                        </article>
                    ))
                }
            </div>
            <p class="mk-price-note">
                价格为参考档位,存储与成员额度可按公司规模单独调整;需要发票、私有部署或存量迁移请另行沟通。
            </p>
        </div>
    </section>

    <!-- ===================== 保障 ===================== -->
    <section class="mk-section" id="assure">
        <div class="mk-wrap">
            <div class="mk-section-head mk-reveal">
                <span class="mk-eyebrow"
                    ><i class="fa-solid fa-shield-halved"></i> 保障</span
                >
                <h2 class="mk-h2" style="margin-top:16px">
                    你敢把素材放进来,是因为这些底线在
                </h2>
            </div>
            <div class="mk-assure">
                {
                    ASSURANCE.map((a) => (
                        <div class="mk-assure-item mk-reveal">
                            <i class:list={["fa-solid", a.icon]} />
                            <div>
                                <h3 class="mk-h3">{a.title}</h3>
                                <p>{a.desc}</p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ===================== FAQ ===================== -->
    <section class="mk-section" id="faq" style="background:var(--mk-bg-soft)">
        <div class="mk-wrap">
            <div class="mk-section-head mk-reveal">
                <span class="mk-eyebrow"
                    ><i class="fa-regular fa-circle-question"></i> 常见问题</span
                >
                <h2 class="mk-h2" style="margin-top:16px">
                    先把最容易被问的说清楚
                </h2>
            </div>
            <div class="mk-faq">
                {
                    FAQS.map((f) => (
                        <details class="mk-reveal">
                            <summary>
                                {f.q}
                                <i class="fa-solid fa-chevron-down" />
                            </summary>
                            <div class="mk-faq-body">{f.a}</div>
