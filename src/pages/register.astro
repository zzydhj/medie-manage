---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
---

<Base
    title={SITE.openRegistration
        ? "免费开通 · 资料素材库"
        : "申请开通 · 资料素材库"}
>
    <main
        class="min-h-screen flex items-center justify-center p-4"
        style="background: linear-gradient(135deg,#1e3a8a,#3b82f6 60%,#60a5fa);"
    >
        <div
            class="w-full max-w-sm bg-white rounded-2xl shadow-2xl overflow-hidden"
        >
            <div class="px-6 py-7 text-center border-b border-slate-100">
                <a href="/" class="inline-block" title="返回官网首页">
                    <div
                        class="w-14 h-14 mx-auto rounded-2xl flex items-center justify-center mb-3"
                        style="background:linear-gradient(135deg,#2563eb,#60a5fa);"
                    >
                        <i class="fa-solid fa-book-open text-white text-xl"></i>
                    </div>
                </a>
                <h1 class="text-lg font-extrabold text-slate-800">
                    {
                        SITE.openRegistration
                            ? "开通你的素材库"
                            : "申请开通素材库"
                    }
                </h1>
                <p class="text-xs text-slate-400 mt-1">
                    {
                        SITE.openRegistration
                            ? "填写公司信息,注册后立即进入后台"
                            : "当前为人工开户,请联系管理员为你开通"
                    }
                </p>
            </div>

            {/* 自助注册关闭时:只展示提示与人工开户指引,不渲染表单 */}
            {
                !SITE.openRegistration && (
                    <div class="px-6 py-7 text-center">
                        <div class="w-12 h-12 mx-auto rounded-2xl flex items-center justify-center mb-3 bg-amber-50">
                            <i class="fa-solid fa-hourglass-half text-amber-500 text-lg" />
                        </div>
                        <h2 class="text-sm font-bold text-slate-700">
                            自助开通正在接入防刷验证
                        </h2>
                        <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                            为避免脚本批量注册,自助开通暂时关闭。{" "}
                            {SITE.contact ? (
                                <>
                                    请联系{" "}
                                    <b class="text-slate-700">{SITE.contact}</b>{" "}
                                    开通,当天即可使用。
                                </>
                            ) : (
                                <>请联系网站管理员开通账号。</>
                            )}
                        </p>
                        <a href="/login" class="btn btn-primary w-full mt-5">
                            <i class="fa-solid fa-right-to-bracket mr-1" />{" "}
                            已有账号,去登录
                        </a>
                    </div>
                )
            }

            <form
                id="reg-form"
                class:list={[
                    "px-6 py-6 flex flex-col gap-4",
                    { hidden: !SITE.openRegistration },
                ]}
            >
                <div class="field">
                    <label for="orgName">公司名称</label>
                    <input
                        id="orgName"
                        name="orgName"
                        type="text"
                        maxlength="40"
                        placeholder="例:光影传媒有限公司"
                        required
                    />
                </div>
                <div class="field">
                    <label for="username">管理员用户名</label>
                    <input
                        id="username"
                        name="username"
                        type="text"
                        autocomplete="username"
                        minlength="3"
                        maxlength="24"
                        placeholder="3-24 位,字母/数字/下划线/中文"
                        required
                    />
                </div>
                <div class="field">
                    <label for="password">登录密码</label>
                    <input
                        id="password"
                        name="password"
                        type="password"
                        autocomplete="new-password"
                        minlength="6"
                        maxlength="72"
                        placeholder="至少 6 位"
                        required
                    />
                </div>
                <div class="field">
                    <label for="password2">确认密码</label>
                    <input
                        id="password2"
                        name="password2"
                        type="password"
                        autocomplete="new-password"
                        required
                    />
                </div>
                <!-- 蜜罐:视觉隐藏且移出 Tab 顺序,真人不会填,机器人常会填 -->
                <div
                    class="absolute -left-[9999px] h-0 overflow-hidden"
                    aria-hidden="true"
                >
                    <label for="website">请勿填写此项</label>
                    <input
                        id="website"
                        name="website"
                        type="text"
                        tabindex="-1"
                        autocomplete="off"
                    />
                </div>
                <div
                    id="reg-error"
                    class="text-xs font-semibold text-red-500 hidden"
                >
                </div>
                <button
                    type="submit"
                    id="reg-btn"
                    class="btn btn-primary w-full"
                >
                    <i class="fa-solid fa-rocket mr-1"></i> 立即开通
                </button>
                <p
                    class="text-[11px] text-slate-400 text-center leading-relaxed"
                >
                    开通即含 <b class="text-slate-500">14 天免费试用</b
                    >,试用到期后需续费才能继续读写素材。
                </p>
            </form>

            <div
                class="px-6 pb-6 -mt-1 flex items-center justify-between text-xs text-slate-500"
            >
                <a href="/login" class="hover:text-blue-600 font-semibold">
                    <i class="fa-solid fa-right-to-bracket mr-1"
                    ></i>已有账号,去登录
                </a>
                <a href="/" class="hover:text-blue-600">← 返回官网</a>
            </div>
        </div>
    </main>

    <script>
        const form = document.getElementById("reg-form") as HTMLFormElement;
        const btn = document.getElementById("reg-btn") as HTMLButtonElement;
        const errBox = document.getElementById("reg-error") as HTMLDivElement;

        function showErr(msg: string) {
            errBox.textContent = msg;
            errBox.classList.remove("hidden");
            btn.disabled = false;
        }

        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            errBox.classList.add("hidden");
            btn.disabled = true;

            const val = (id: string) =>
                (document.getElementById(id) as HTMLInputElement).value;
            const password = val("password");
            if (password !== val("password2"))
                return showErr("两次输入的密码不一致");

            try {
                const res = await fetch("/api/auth/register", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        orgName: val("orgName").trim(),
                        username: val("username").trim(),
                        password,
                        website: val("website"), // 蜜罐,正常为空
                    }),
                });
                const data = (await res.json()) as { error?: string };
                if (!res.ok)
                    return showErr(data.error || "开通失败,请稍后再试");
                window.location.href = "/app";
            } catch {
                showErr("网络异常,请稍后再试");
            }
        });
    </script>
</Base>
