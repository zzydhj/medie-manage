    <script>
        // 截图缺失降级:图片加载失败时给外层容器加 *-missing 类,由 CSS 换成线框占位
        document
            .querySelectorAll<HTMLImageElement>("img[data-shot]")
            .forEach((img) => {
                const mark = () => {
                    const host = img.closest(".mk-shot, .mk-figure");
                    if (!host) return;
                    host.classList.add(
                        host.classList.contains("mk-shot")
                            ? "mk-shot-missing"
                            : "mk-figure-missing",
                    );
                };
                // 命中缓存的失败响应不会再报错,用 complete + naturalWidth 补判一次
                if (img.complete && img.naturalWidth === 0) mark();
                else img.addEventListener("error", mark, { once: true });
            });

        // 入场动效:元素进视口再淡入上移;一次性观察后取消,避免长期占用
        const io = new IntersectionObserver(
            (entries) => {
                for (const e of entries) {
                    if (!e.isIntersecting) continue;
                    e.target.classList.add("mk-in");
                    io.unobserve(e.target);
                }
            },
            { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        document.querySelectorAll(".mk-reveal").forEach((el) => io.observe(el));

        // 锚点跳转时给 sticky 导航让位,避免标题被压住
        document
            .querySelectorAll<HTMLAnchorElement>(
                '.mk-nav-links a, .mk-footer-links a[href^="#"]',
            )
            .forEach((a) => {
                a.addEventListener("click", (ev) => {
                    const id = a.getAttribute("href");
                    if (!id?.startsWith("#")) return;
                    const target = document.querySelector(id);
                    if (!target) return;
                    ev.preventDefault();
                    const top =
                        target.getBoundingClientRect().top +
                        window.scrollY -
                        82;
                    window.scrollTo({ top, behavior: "smooth" });
                });
            });
    </script>
